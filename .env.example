# Your Discord account token (NEVER share this with anyone)
TOKEN=

# Discord channel ID where you play EPIC RPG (example: 123456789012345678)
CHANNEL_ID=

# Channel IDs monitored for Auto-Join Epic Events (optional, comma-separated for multiple)
EVENT_CHANNEL_IDS=

# Channel IDs monitored for Auto-Join Arena & Miniboss (optional, comma-separated for multiple)
ARENA_CHANNEL_IDS=
MINIBOSS_CHANNEL_IDS=

# Runtime mode: set to true for plain console logs without Live TUI (auto-enabled on headless VMs/Docker)
HEADLESS=false

# Optional IANA timezone for logs & Telegram panel (example: Asia/Jakarta)
TIMEZONE=

# Telegram Remote Control Panel & EPIC GUARD Alerts (optional, recommended for VM hosting)
# Create a bot via @BotFather and get your numeric chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_LIVE_AUTO=true
TELEGRAM_LIVE_INTERVAL_SEC=12
